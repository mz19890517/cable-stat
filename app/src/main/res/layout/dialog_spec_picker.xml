<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tv_pick_group_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="芯数分组"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_label"
            android:visibility="gone" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cg_pick_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:visibility="gone"
            app:singleSelection="true"
            app:selectionRequired="true">

            <!-- 线缆芯数分组 chips（单芯/2芯/3芯/3+1…）动态填充 -->
        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:id="@+id/tv_pick_spec_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="规格"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_label"
            android:layout_marginTop="10dp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cg_pick_spec"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:singleSelection="true">

            <!-- 规格 chips 动态填充 -->
        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="候选池里没有？手动输入"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_label"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/et_pick_custom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input"
            android:padding="10dp"
            android:hint="如 3×2.5+1×1.5 或 40×5"
            android:inputType="text"
            android:textColorHint="@color/text_hint"
            android:importantForAutofill="no" />

        <TextView
            android:id="@+id/btn_pick_use"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="12dp"
            android:gravity="center"
            android:text="使用手动输入的规格"
            android:textColor="@color/primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/bg_input" />
    </LinearLayout>
</ScrollView>
