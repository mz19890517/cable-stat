<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_input"
    android:padding="14dp"
    android:layout_marginHorizontal="12dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="2dp">

    <TextView
        android:id="@+id/tv_kind_badge"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="线"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:background="@drawable/pill_wire" />

    <TextView
        android:id="@+id/tv_group_spec"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:text="1.5mm²"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginEnd="10dp">

        <TextView
            android:id="@+id/tv_group_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0mm"
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="end" />

        <TextView
            android:id="@+id/tv_group_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="共0根"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_group_add"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_add"
        android:contentDescription="记一笔"
        android:tint="@color/primary"
        android:scaleType="centerInside" />

    <ImageView
        android:id="@+id/iv_group_expand"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_expand"
        android:contentDescription="展开"
        android:tint="@color/text_secondary" />
</LinearLayout>