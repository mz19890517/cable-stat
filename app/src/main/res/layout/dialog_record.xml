<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/tv_append_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_kind_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="分类"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cg_kind"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_kind_wire"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="线缆"
                app:checkedIconVisible="false" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_kind_busbar"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="铜排"
                app:checkedIconVisible="false" />
        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:id="@+id/tv_spec_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="规格"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="16dp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cg_spec"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:singleSelection="true">

            <!-- 规格 chips 动态填充 -->
        </com.google.android.material.chip.ChipGroup>

        <EditText
            android:id="@+id/et_spec_custom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="或手动输入规格（铜排如 40×5）"
            android:inputType="text"
            android:importantForAutofill="no"
            android:layout_marginTop="8dp"
            android:visibility="visible" />

        <TextView
            android:id="@+id/tv_color_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="颜色"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="16dp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cg_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:singleSelection="true">

            <!-- 颜色 chips 动态填充 -->
        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:id="@+id/tv_len_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="每根长度（毫米 mm，每行一根）"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/et_length"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:minLines="3"
            android:hint="每行填一根，例如：&#10;1850&#10;3200&#10;1500"
            android:inputType="textMultiLine"
            android:importantForAutofill="no"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tv_length_preview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tv_existing_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tv_note_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="备注（可空）"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/et_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="例如：出线到电抗器"
            android:inputType="text"
            android:importantForAutofill="no"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/tv_stage_add_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="12dp"
            android:gravity="center"
            android:text="＋ 添加到批量列表"
            android:textColor="@color/primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/bg_input" />

        <TextView
            android:id="@+id/tv_staging_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="批量列表（点击项可编辑/删除）"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/ll_staging"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btn_stage_submit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="14dp"
            android:gravity="center"
            android:text="全部入库"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@color/primary" />
    </LinearLayout>
</ScrollView>